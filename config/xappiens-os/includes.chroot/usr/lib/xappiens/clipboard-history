#!/usr/bin/python3
"""XappiensOS clipboard history: a Wayland popup with session-only storage."""

import os
from pathlib import Path
import signal
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, GtkLayerShell

from clipboard_history import History, MAX_ITEM_BYTES


APP_ID = "org.xappiens.ClipboardHistory"
PROGRAM = str(Path(__file__).resolve())


class ClipboardHistory(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
            | Gio.ApplicationFlags.SEND_ENVIRONMENT,
        )
        self.history = History()
        self.watchers = {}
        self.window = None
        self.pending_paste = 0
        self.captures = {}
        self.stopping = False
        self.status = ""

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.hold()
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.stop)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self.stop)
        self.watch_timer = GLib.timeout_add_seconds(3, self.check_watchers)
        self.check_watchers()

    def stop(self):
        self.quit()
        return GLib.SOURCE_REMOVE

    def do_shutdown(self):
        self.stopping = True
        self.cancel_paste()
        for capture in list(self.captures.values()):
            capture["cancel"].cancel()
        GLib.source_remove(self.watch_timer)
        for watcher in self.watchers.values():
            if watcher.poll() is None:
                watcher.terminate()
        for watcher in self.watchers.values():
            try:
                watcher.wait(timeout=1)
            except subprocess.TimeoutExpired:
                watcher.kill()
                watcher.wait()
        self.history.clear()
        Gtk.Application.do_shutdown(self)

    def check_watchers(self):
        if self.stopping:
            return GLib.SOURCE_REMOVE
        for kind in ("text", "image"):
            old = self.watchers.get(kind)
            if old is None or old.poll() is not None:
                self.watchers[kind] = subprocess.Popen(
                    ["wl-paste", "--type", kind, "--watch", PROGRAM, "--capture", kind],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    # Errors contain protocol diagnostics, never clipboard contents.
                    stderr=None,
                )
        return GLib.SOURCE_CONTINUE

    def do_command_line(self, command):
        args = command.get_arguments()[1:]
        if args[:1] == ["--capture"]:
            if len(args) != 2 or args[1] not in ("text", "image"):
                return 2
            if command.getenv("CLIPBOARD_STATE") in ("sensitive", "nil", "clear"):
                return 0
            self.read_capture(command, args[1])
            return 0
        if args == ["--daemon"]:
            return 0
        if args:
            command.printerr_literal("Uso: clipboard-history [--daemon]\n")
            return 2
        self.toggle()
        return 0

    def read_capture(self, command, kind):
        stream = command.get_stdin()
        if stream is None or len(self.captures) >= 4:
            return
        # Keep the command alive until EOF: the remote wl-paste helper waits
        # for its completion. Slow or malicious clipboard owners must never
        # block GTK's event loop, and each transfer has a five-second deadline.
        token = object()
        state = {"command": command, "cancel": Gio.Cancellable(), "data": bytearray()}
        self.captures[token] = state

        def expired():
            state["timer"] = 0
            state["cancel"].cancel()
            return GLib.SOURCE_REMOVE

        def finish(store=False):
            if state["timer"]:
                GLib.source_remove(state["timer"])
                state["timer"] = 0
            self.captures.pop(token, None)
            if store and not self.stopping and not state["cancel"].is_cancelled():
                self.capture(kind, bytes(state["data"]))
            state["data"].clear()
            state["command"].set_exit_status(0)
            if hasattr(state["command"], "done"):
                state["command"].done()
            state.pop("command")

        def received(source, result):
            try:
                chunk = source.read_bytes_finish(result)
            except GLib.Error:
                finish()
                return
            if not chunk.get_size():
                finish(store=True)
                return
            state["data"].extend(chunk.get_data())
            if len(state["data"]) > MAX_ITEM_BYTES:
                finish()
                return
            read_next()

        def read_next():
            stream.read_bytes_async(
                min(65536, MAX_ITEM_BYTES + 1 - len(state["data"])),
                GLib.PRIORITY_DEFAULT, state["cancel"], received,
            )

        state["timer"] = GLib.timeout_add_seconds(5, expired)
        read_next()

    def capture(self, kind, data):
        if not data:
            return
        mime = "text/plain;charset=utf-8"
        if kind == "image":
            # wl-paste chooses an offered image format. Determine it from its
            # header rather than pretending all applications supplied PNG.
            try:
                loader = GdkPixbuf.PixbufLoader.new()
                loader.set_size(1, 1)
                loader.write(data)
                loader.close()
                fmt = loader.get_format()
                if fmt is None:
                    return
                mime = fmt.get_mime_types()[0]
            except GLib.Error:
                return
        if self.history.add(mime, data) and self.window and self.window.get_visible():
            self.refresh()

    def build_window(self):
        self.window = Gtk.ApplicationWindow(application=self, title="Portapapeles")
        self.window.set_default_size(410, 510)
        self.window.set_resizable(False)
        self.window.set_border_width(16)
        # A layer surface stays a floating popup even with COSMIC autotiling.
        GtkLayerShell.init_for_window(self.window)
        GtkLayerShell.set_namespace(self.window, "xappiens-clipboard-history")
        GtkLayerShell.set_layer(self.window, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(self.window, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        for edge in (GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self.window, edge, True)
        GtkLayerShell.set_margin(self.window, GtkLayerShell.Edge.BOTTOM, 72)
        GtkLayerShell.set_margin(self.window, GtkLayerShell.Edge.RIGHT, 24)
        self.window.connect("delete-event", lambda *_: self.hide())
        self.window.connect("key-press-event", self.on_key)

        layout = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.window.add(layout)
        header = Gtk.Box(spacing=12)
        title = Gtk.Label(label="Portapapeles", xalign=0)
        title.get_style_context().add_class("title")
        header.pack_start(title, True, True, 0)
        clear = Gtk.Button(label="Vaciar")
        clear.set_tooltip_text("Borrar el historial de esta sesión")
        clear.connect("clicked", self.clear_history)
        header.pack_start(clear, False, False, 0)
        close = Gtk.Button.new_from_icon_name("window-close-symbolic", Gtk.IconSize.BUTTON)
        close.set_tooltip_text("Cerrar (Esc)")
        close.connect("clicked", lambda *_: self.hide())
        header.pack_start(close, False, False, 0)
        layout.pack_start(header, False, False, 0)

        self.search = Gtk.SearchEntry(placeholder_text="Buscar en esta sesión…")
        self.search.connect("key-press-event", self.on_key)
        self.search.connect("search-changed", lambda *_: self.refresh())
        self.search.connect("activate", self.activate_selected)
        layout.pack_start(self.search, False, False, 0)
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_min_content_height(320)
        scroller.set_max_content_height(480)
        self.rows = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.rows.connect("key-press-event", self.on_key)
        self.rows.set_activate_on_single_click(True)
        self.rows.connect("row-activated", self.activate_selected)
        scroller.add(self.rows)
        layout.pack_start(scroller, True, True, 0)
        self.footer = Gtk.Label(xalign=0)
        self.footer.set_line_wrap(True)
        self.footer.get_style_context().add_class("dim-label")
        layout.pack_start(self.footer, False, False, 0)

    def toggle(self):
        self.cancel_paste()
        if self.window and self.window.get_visible():
            self.hide()
            return
        if self.window is None:
            self.build_window()
        self.search.set_text("")
        self.refresh()
        self.window.show_all()
        self.search.grab_focus()

    def hide(self):
        self.cancel_paste()
        if self.window:
            self.window.hide()
            Gdk.Display.get_default().sync()
        return True

    def refresh(self):
        query = self.search.get_text().casefold()
        for row in self.rows.get_children():
            self.rows.remove(row)
        for entry in self.history.entries:
            if query and query not in ("imagen" if entry.is_image else entry.text.casefold()):
                continue
            row = Gtk.ListBoxRow()
            row.entry = entry
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            content.set_border_width(10)
            if entry.is_image:
                try:
                    loader = GdkPixbuf.PixbufLoader.new()
                    loader.connect("size-prepared", self.scale_preview)
                    loader.write(entry.data)
                    loader.close()
                    content.pack_start(Gtk.Image.new_from_pixbuf(loader.get_pixbuf()), False, False, 0)
                except GLib.Error:
                    pass
                label = Gtk.Label(label="Imagen", xalign=0)
            else:
                # Display plain text only; clipboard text is never markup.
                label = Gtk.Label(label=entry.text[:500], xalign=0)
                label.set_line_wrap(True)
                label.set_lines(3)
                label.set_max_width_chars(44)
                label.set_ellipsize(3)  # Pango.EllipsizeMode.END
            content.pack_start(label, False, False, 0)
            row.add(content)
            self.rows.add(row)
        if not self.rows.get_children():
            empty = Gtk.ListBoxRow(activatable=False, selectable=False)
            message = "Sin coincidencias" if query else "Lo que copies aparecerá aquí."
            label = Gtk.Label(label=message)
            label.set_margin_top(32)
            label.set_margin_bottom(32)
            empty.add(label)
            self.rows.add(empty)
        else:
            self.rows.select_row(self.rows.get_row_at_index(0))
        self.rows.show_all()
        self.footer.set_text(self.status or "Solo esta sesión · Selecciona para pegar · Esc para cerrar")

    @staticmethod
    def scale_preview(loader, width, height):
        scale = min(350 / max(1, width), 140 / max(1, height), 1)
        loader.set_size(max(1, int(width * scale)), max(1, int(height * scale)))

    def on_key(self, _window, event):
        if event.keyval == Gdk.KEY_Escape:
            self.hide()
            return True
        focused = self.window.get_focus()
        in_list = focused is self.rows or (focused and focused.is_ancestor(self.rows))
        if event.keyval in (Gdk.KEY_Down, Gdk.KEY_Up) and (self.search.has_focus() or in_list):
            row = self.rows.get_selected_row()
            index = row.get_index() if row else 0
            if in_list:
                index += 1 if event.keyval == Gdk.KEY_Down else -1
            target = self.rows.get_row_at_index(max(0, index))
            if target and target.get_selectable():
                self.rows.select_row(target)
                target.grab_focus()
            return True
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and (self.search.has_focus() or in_list):
            self.activate_selected()
            return True
        return False

    def clear_history(self, *_args):
        self.cancel_paste()
        for capture in list(self.captures.values()):
            capture["cancel"].cancel()
        self.history.clear()
        self.status = ""
        self.refresh()

    def cancel_paste(self):
        if self.pending_paste:
            GLib.source_remove(self.pending_paste)
            self.pending_paste = 0

    def activate_selected(self, *_args):
        row = self.rows.get_selected_row()
        if row is None or not hasattr(row, "entry"):
            return
        entry = row.entry
        self.cancel_paste()
        # Feed bytes via stdin, never through shell commands, arguments or files.
        try:
            proc = subprocess.run(
                ["wl-copy", "--type", entry.mime], input=entry.data,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3,
            )
        except (OSError, subprocess.TimeoutExpired):
            self.status = "No se pudo preparar el pegado. Vuelve a intentarlo."
            self.refresh()
            return
        if proc.returncode:
            self.status = "No se pudo preparar el pegado. Vuelve a intentarlo."
            self.refresh()
            return
        # COSMIC Terminal uses PRIMARY for Shift+Insert, while GTK, Chromium
        # and COSMIC text fields use CLIPBOARD. Publish to both selections only
        # when the user chooses an entry; PRIMARY is never monitored.
        try:
            proc = subprocess.run(
                ["wl-copy", "--primary", "--type", entry.mime], input=entry.data,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3,
            )
        except (OSError, subprocess.TimeoutExpired):
            proc = None
        if proc is None or proc.returncode:
            self.status = "No se pudo preparar el pegado. Vuelve a intentarlo."
            self.refresh()
            return
        self.history.add(entry.mime, entry.data)
        self.hide()
        # Unmapping the exclusive layer restores the previously focused client.
        self.pending_paste = GLib.timeout_add(180, self.paste)

    def paste(self):
        self.pending_paste = 0
        if self.window and self.window.get_visible():
            return GLib.SOURCE_REMOVE
        try:
            proc = subprocess.run(
                [str(Path(PROGRAM).with_name("paste-key"))],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2,
            )
            failed = proc.returncode != 0
        except (OSError, subprocess.TimeoutExpired):
            failed = True
        if failed:
            self.status = "Contenido copiado. Pulsa Ctrl + V en la aplicación para pegarlo."
            self.send_notification(
                "paste-failed",
                Gio.Notification.new("Contenido copiado: pulsa Ctrl + V para pegarlo"),
            )
        else:
            self.status = ""
        return GLib.SOURCE_REMOVE


def main():
    if "--help" in sys.argv[1:]:
        print("Uso: clipboard-history [--daemon]\nSuper + V: abrir o cerrar el historial de esta sesión.")
        return 0
    if not os.environ.get("WAYLAND_DISPLAY"):
        print("El historial de XappiensOS necesita una sesión Wayland.", file=sys.stderr)
        return 1
    if not sys.argv[1:]:
        # Start through systemd even when the shortcut wins the race against
        # desktop autostart, so the history always stops at COSMIC logout.
        try:
            started = subprocess.run(
                ["systemctl", "--user", "start", "xappiens-clipboard-history.service"],
                timeout=10, check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            return 1
        if started.returncode:
            return 1
    return ClipboardHistory().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
